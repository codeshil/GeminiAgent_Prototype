# .streamlit/secrets.toml
# Copy this file to .streamlit/secrets.toml and fill in your real keys.
# Do NOT commit the real secrets.toml to git.

GEMINI_API_KEY = "your-gemini-api-key-here"
YOUTUBE_API_KEY = "your-youtube-data-api-v3-key-here"

# Owner-only access key for the Session log admin view.
# Set this to a long, non-obvious string. To inspect the log, visit:
#   https://your-app.streamlit.app/?admin=THE_VALUE_YOU_SET_HERE
# Without this set (or without the matching ?admin= param), the log
# is completely hidden — users see no extra UI.
ADMIN_KEY = "pick-a-long-random-string-here"
